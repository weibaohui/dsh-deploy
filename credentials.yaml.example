# Copy this file to credentials.yaml and fill in your LLM provider API key, then run install.sh:
#   cp credentials.yaml.example credentials.yaml
#   # then edit credentials.yaml: replace <your-api-key> with your real key
#
# The default example below uses MiniMax (provider "minimax-cn", env MINIMAX_CN_API_KEY),
# matching the provider block already configured in settings.yaml — so it runs out of the box.
#
# To use a different provider, change the env name to that provider's, e.g.:
#   DEEPSEEK_API_KEY / OPENAI_API_KEY / ZHIPUAI_API_KEY / DASHSCOPE_API_KEY / MOONSHOT_API_KEY
# (env names vary by provider — check your provider's docs), AND mirror the same
# provider id + apiKeyEnv + model id in settings.yaml (see the "Swap provider" note there).
version: 1
refs:
  MINIMAX_CN_API_KEY: <your-api-key>
